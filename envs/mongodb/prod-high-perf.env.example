# ==============================================================================
# MongoDB 8.0 - Production High-Performance Environment (.env.example)
# Tuned for high-read/write document storage workloads with WiredTiger engine
# ==============================================================================

# Global Settings
TZ=UTC
BIND_IP=0.0.0.0
DATA_DIR=/var/lib/database-hub/data
DOCKER_NETWORK_NAME=database-hub-net

# MongoDB Production Configuration
MONGO_IMAGE=mongo:8.0
MONGO_CONTAINER_NAME=database-hub-mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_TO_A_VERY_STRONG_MONGO_PASSWORD
MONGO_INITDB_DATABASE=production_db

# WiredTiger Engine Cache (Set to ~50% of available server RAM, e.g. 4GB for 8GB server)
MONGO_CACHE_SIZE_GB=4
