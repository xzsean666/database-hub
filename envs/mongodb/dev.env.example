# ==============================================================================
# MongoDB 7.0 - Development Environment (.env.example)
# Lightweight setup for local document database development
# ==============================================================================

# Global Settings
TZ=UTC
BIND_IP=127.0.0.1
DATA_DIR=./data
DOCKER_NETWORK_NAME=database-hub-net

# MongoDB Basic Configuration
MONGO_IMAGE=mongo:7.0
MONGO_CONTAINER_NAME=database-hub-mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_dev_password
MONGO_INITDB_DATABASE=app_dev

# WiredTiger Cache (1GB memory bound for local dev)
MONGO_CACHE_SIZE_GB=1
