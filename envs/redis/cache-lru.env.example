# ==============================================================================
# Redis 7.2 - In-Memory Cache (LRU) Environment (.env.example)
# Ideal for API caching, session caching, and ephemeral key-value workloads
# ==============================================================================

# Global Settings
TZ=UTC
BIND_IP=0.0.0.0
DATA_DIR=./data
DOCKER_NETWORK_NAME=database-hub-net

# Redis Configuration
REDIS_IMAGE=redis:7.2-alpine
REDIS_CONTAINER_NAME=database-hub-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Memory & Policy
# allkeys-lru: Evicts the least recently used keys when maxmemory is reached
REDIS_MAX_MEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
