# ==============================================================================
# Redis 7.4 - In-Memory Cache (LRU) Environment (.env.example)
# Ideal for API caching, session caching, and ephemeral key-value workloads
# ==============================================================================

# Instance & Cluster Identification (MUST be unique per instance on the same host)
INSTANCE_ID=database-hub
COMPOSE_PROJECT_NAME=${INSTANCE_ID}

# Global Settings
TZ=UTC
BIND_IP=0.0.0.0
DATA_DIR=./data
DOCKER_NETWORK_NAME=${INSTANCE_ID}-net

# Redis Configuration
REDIS_IMAGE=redis:7.4-alpine
REDIS_CONTAINER_NAME=${INSTANCE_ID}-redis
REDIS_DATA_DIR=${DATA_DIR}/redis/${REDIS_CONTAINER_NAME}
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Memory & Policy
# allkeys-lru: Evicts the least recently used keys when maxmemory is reached
REDIS_MAX_MEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
