# ==============================================================================
# Redis 7.4 - Persistent Key-Value Store Environment (.env.example)
# Ideal for message queues (BullMQ/Celery), pub/sub, and durable state storage
# ==============================================================================

# Instance & Cluster Identification (MUST be unique per instance on the same host)
INSTANCE_ID=database-hub
COMPOSE_PROJECT_NAME=${INSTANCE_ID}

# Global Settings
TZ=UTC
BIND_IP=0.0.0.0
DATA_DIR=/var/lib/database-hub/data
DOCKER_NETWORK_NAME=${INSTANCE_ID}-net

# Redis Configuration
REDIS_IMAGE=redis:7.4-alpine
REDIS_CONTAINER_NAME=${INSTANCE_ID}-redis
REDIS_DATA_DIR=${DATA_DIR}/redis/${REDIS_CONTAINER_NAME}
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Memory & Eviction Policy
# volatile-lru: Only evicts keys with an expire (TTL) set, preserving permanent keys
REDIS_MAX_MEMORY=4gb
REDIS_MAXMEMORY_POLICY=volatile-lru
