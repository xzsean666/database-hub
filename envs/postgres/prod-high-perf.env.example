# ==============================================================================
# PostgreSQL - Production High-Performance Environment (.env.example)
# Optimized for servers with >= 8GB RAM, NVMe/SSD, and high concurrency
# ==============================================================================

# Global Settings
TZ=UTC
BIND_IP=0.0.0.0
DATA_DIR=/var/lib/database-hub/data
DOCKER_NETWORK_NAME=database-hub-net

# PostgreSQL Production Configuration
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_CONTAINER_NAME=database-hub-postgres
POSTGRES_PORT=5432
POSTGRES_DB=production_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_TO_A_VERY_STRONG_PASSWORD

# High-Performance Tuning (Calculated for ~8-16GB RAM host)
POSTGRES_SHM_SIZE=2g
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=2GB
POSTGRES_EFFECTIVE_CACHE_SIZE=6GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB
