# ==============================================================================
# PostgreSQL - Development Environment (.env.example)
# Low-memory usage, ideal for local development and staging testing
# ==============================================================================

# Instance & Cluster Identification (MUST be unique per instance on the same host)
INSTANCE_ID=database-hub
COMPOSE_PROJECT_NAME=${INSTANCE_ID}

# Global Settings
TZ=UTC
BIND_IP=127.0.0.1
DATA_DIR=./data
DOCKER_NETWORK_NAME=${INSTANCE_ID}-net

# PostgreSQL Basic Configuration
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_CONTAINER_NAME=${INSTANCE_ID}-postgres
POSTGRES_DATA_DIR=${DATA_DIR}/postgres/${POSTGRES_CONTAINER_NAME}
POSTGRES_PORT=5432
POSTGRES_DB=app_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Memory & Performance (Tuned for ~1-2GB RAM dev machines)
POSTGRES_SHM_SIZE=256m
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
