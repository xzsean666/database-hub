# ==============================================================================
# PostgreSQL - Development Environment (.env.example)
# Low-memory usage, ideal for local development and staging testing
# ==============================================================================

# Global Settings
TZ=UTC
BIND_IP=127.0.0.1
DATA_DIR=./data
DOCKER_NETWORK_NAME=database-hub-net

# PostgreSQL Basic Configuration
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=database-hub-postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password

# Memory & Performance (Tuned for ~1-2GB RAM dev machines)
POSTGRES_SHM_SIZE=256m
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB
