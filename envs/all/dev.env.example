# ==============================================================================
# All Databases - Development Environment (.env.example)
# Runs PostgreSQL, MySQL, MongoDB, and Redis on a single dev host
# ==============================================================================

# Instance & Cluster Identification (MUST be unique per instance on the same host)
INSTANCE_ID=database-hub
COMPOSE_PROJECT_NAME=${INSTANCE_ID}

# Global Settings
TZ=UTC
BIND_IP=127.0.0.1
DATA_DIR=./data
DOCKER_NETWORK_NAME=${INSTANCE_ID}-net

# 1. PostgreSQL (Dev)
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_CONTAINER_NAME=${INSTANCE_ID}-postgres
POSTGRES_DATA_DIR=${DATA_DIR}/postgres/${POSTGRES_CONTAINER_NAME}
POSTGRES_PORT=5432
POSTGRES_DB=app_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
POSTGRES_SHM_SIZE=256m
POSTGRES_MAX_CONNECTIONS=50
POSTGRES_SHARED_BUFFERS=256MB
POSTGRES_EFFECTIVE_CACHE_SIZE=512MB
POSTGRES_WORK_MEM=8MB
POSTGRES_MAINTENANCE_WORK_MEM=64MB

# 2. MySQL (Dev)
MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=${INSTANCE_ID}-mysql
MYSQL_DATA_DIR=${DATA_DIR}/mysql/${MYSQL_CONTAINER_NAME}
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=app_dev
MYSQL_USER=dev_user
MYSQL_PASSWORD=dev_password
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=100
MYSQL_FLUSH_LOG_AT_TRX_COMMIT=2

# 3. MongoDB (Dev)
MONGO_IMAGE=mongo:8.0
MONGO_CONTAINER_NAME=${INSTANCE_ID}-mongodb
MONGO_DATA_DIR=${DATA_DIR}/mongodb/${MONGO_CONTAINER_NAME}
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_dev_password
MONGO_INITDB_DATABASE=app_dev
MONGO_CACHE_SIZE_GB=1

# 4. Redis (Dev)
REDIS_IMAGE=redis:7.4-alpine
REDIS_CONTAINER_NAME=${INSTANCE_ID}-redis
REDIS_DATA_DIR=${DATA_DIR}/redis/${REDIS_CONTAINER_NAME}
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_password
REDIS_MAX_MEMORY=512mb
REDIS_MAXMEMORY_POLICY=allkeys-lru
