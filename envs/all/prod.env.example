# ==============================================================================
# All Databases - Production Environment (.env.example)
# Runs all 4 databases tuned for dedicated server with >= 16GB RAM
# ==============================================================================

# Global Settings
TZ=UTC
BIND_IP=0.0.0.0
DATA_DIR=/var/lib/database-hub/data
DOCKER_NETWORK_NAME=database-hub-net

# 1. PostgreSQL (Production)
POSTGRES_IMAGE=postgres:18-alpine
POSTGRES_CONTAINER_NAME=database-hub-postgres
POSTGRES_PORT=5432
POSTGRES_DB=production_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_SHM_SIZE=2g
POSTGRES_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=3GB
POSTGRES_EFFECTIVE_CACHE_SIZE=8GB
POSTGRES_WORK_MEM=32MB
POSTGRES_MAINTENANCE_WORK_MEM=512MB

# 2. MySQL (Production)
MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=database-hub-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=production_db
MYSQL_USER=prod_user
MYSQL_PASSWORD=CHANGE_ME_MYSQL_USER_PASSWORD
MYSQL_BUFFER_POOL_SIZE=4G
MYSQL_MAX_CONNECTIONS=500
MYSQL_FLUSH_LOG_AT_TRX_COMMIT=2

# 3. MongoDB (Production)
MONGO_IMAGE=mongo:8.0
MONGO_CONTAINER_NAME=database-hub-mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_MONGO_ROOT_PASSWORD
MONGO_INITDB_DATABASE=production_db
MONGO_CACHE_SIZE_GB=4

# 4. Redis (Production)
REDIS_IMAGE=redis:7.4-alpine
REDIS_CONTAINER_NAME=database-hub-redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_MAX_MEMORY=2gb
REDIS_MAXMEMORY_POLICY=allkeys-lru
