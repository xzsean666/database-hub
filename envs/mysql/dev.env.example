# ==============================================================================
# MySQL 8.4 LTS - Development Environment (.env.example)
# Lightweight setup suitable for local development
# ==============================================================================

# Global Settings
TZ=UTC
BIND_IP=127.0.0.1
DATA_DIR=./data
DOCKER_NETWORK_NAME=database-hub-net

# MySQL Basic Configuration
MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=database-hub-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=app_dev
MYSQL_USER=dev_user
MYSQL_PASSWORD=dev_password

# Memory & Performance (Tuned for low memory)
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=100
MYSQL_FLUSH_LOG_AT_TRX_COMMIT=2
