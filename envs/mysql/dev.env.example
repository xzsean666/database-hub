# ==============================================================================
# MySQL 8.4 LTS - Development Environment (.env.example)
# Lightweight setup suitable for local development
# ==============================================================================

# Instance & Cluster Identification (MUST be unique per instance on the same host)
INSTANCE_ID=database-hub
COMPOSE_PROJECT_NAME=${INSTANCE_ID}

# Global Settings
TZ=UTC
BIND_IP=127.0.0.1
DATA_DIR=./data
DOCKER_NETWORK_NAME=${INSTANCE_ID}-net

# MySQL Basic Configuration
MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=${INSTANCE_ID}-mysql
MYSQL_DATA_DIR=${DATA_DIR}/mysql/${MYSQL_CONTAINER_NAME}
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root_dev_password
MYSQL_DATABASE=app_dev
MYSQL_USER=dev_user
MYSQL_PASSWORD=dev_password

# Memory & Performance (Tuned for low memory)
MYSQL_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=100
MYSQL_FLUSH_LOG_AT_TRX_COMMIT=2
