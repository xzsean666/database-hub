# ==============================================================================
# MySQL 8.4 LTS - Production High-Performance Environment (.env.example)
# Tuned for high-concurrency transactional systems with fast NVMe disks
# ==============================================================================

# Global Settings
TZ=UTC
BIND_IP=0.0.0.0
DATA_DIR=/var/lib/database-hub/data
DOCKER_NETWORK_NAME=database-hub-net

# MySQL Production Configuration
MYSQL_IMAGE=mysql:8.4
MYSQL_CONTAINER_NAME=database-hub-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME_TO_A_VERY_STRONG_ROOT_PASSWORD
MYSQL_DATABASE=production_db
MYSQL_USER=prod_user
MYSQL_PASSWORD=CHANGE_ME_TO_A_VERY_STRONG_USER_PASSWORD

# High-Performance InnoDB Tuning (Suitable for >= 8GB-16GB RAM)
# 4GB Buffer pool, Direct I/O, Flush log every second for 10x write throughput
MYSQL_BUFFER_POOL_SIZE=4G
MYSQL_MAX_CONNECTIONS=500
MYSQL_FLUSH_LOG_AT_TRX_COMMIT=2
