# ==============================================================================
# Database Hub - Environment Configuration (.env)
# ==============================================================================

# Instance & Cluster Identification
# Crucial for multi-database or multi-instance setups on the same machine.
# Each distinct database stack should have its own unique INSTANCE_ID (e.g. app1, mall-db, user-service).
INSTANCE_ID=database-hub
COMPOSE_PROJECT_NAME=database-hub

# Global Settings
TZ=UTC
BIND_IP=0.0.0.0
DATA_DIR=./data
DOCKER_NETWORK_NAME=database-hub-net

# ==============================================================================
# 1. PostgreSQL Settings & Performance Tuning
# ==============================================================================
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=database-hub-postgres
POSTGRES_PORT=5432
POSTGRES_DB=app_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass

# PostgreSQL Memory & Performance Tuning
POSTGRES_SHM_SIZE=1g
POSTGRES_MAX_CONNECTIONS=200
POSTGRES_SHARED_BUFFERS=1GB
POSTGRES_EFFECTIVE_CACHE_SIZE=3GB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=256MB

# ==============================================================================
# 2. MySQL Settings & Performance Tuning
# ==============================================================================
MYSQL_IMAGE=mysql:8.0
MYSQL_CONTAINER_NAME=database-hub-mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=mysql_root_secure_pass
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=mysql_user_secure_pass

# MySQL Performance Tuning
MYSQL_BUFFER_POOL_SIZE=1G
MYSQL_MAX_CONNECTIONS=300
MYSQL_FLUSH_LOG_AT_TRX_COMMIT=2

# ==============================================================================
# 3. MongoDB Settings & Performance Tuning
# ==============================================================================
MONGO_IMAGE=mongo:7.0
MONGO_CONTAINER_NAME=database-hub-mongodb
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=mongo_root_secure_pass
MONGO_INITDB_DATABASE=app_db

# MongoDB WiredTiger Performance Tuning
MONGO_CACHE_SIZE_GB=2

# ==============================================================================
# 4. Redis Settings & Performance Tuning
# ==============================================================================
REDIS_IMAGE=redis:7.2-alpine
REDIS_CONTAINER_NAME=database-hub-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_pass

# Redis Memory & Policy Tuning
REDIS_MAX_MEMORY=1gb
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ==============================================================================
# 5. Automated Extreme Backup & Retention Settings
# ==============================================================================
AUTO_BACKUP_ENABLED=true
AUTO_BACKUP_SCHEDULE="0 2 * * *"       # Schedule/Cron: daily at 02:00 AM (e.g. daily, 12h, 6h, 0 2 * * *)
AUTO_BACKUP_RETENTION=7                 # Maximum number of backups to retain per database
BACKUP_DIR=./backups                    # Directory for backup files (local or remote /opt/database-hub/backups)
BACKUP_COMPRESSION=zstd                 # Extreme compression engine: zstd (ultra -19), xz (ultra -9e), gzip (max -9)

